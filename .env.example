SECRET_KEY=replace-me-with-50-plus-random-chars-before-production-deploy
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
APP_PORT=8000

DB_NAME=mat_hisobot
DB_USER=postgres
DB_PASSWORD=change-db-password
DB_HOST=/tmp/pgsock
DB_PORT=5433

# Docker birinchi marta ishga tushganda avtomatik admin yaratish (ixtiyoriy)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-admin-password

GEMINI_API_KEY=

# Parolni tiklash xatlarini yuborish uchun SMTP (parol bo'sh bo'lsa havola terminal/logga chiqadi)
# Gmail uchun EMAIL_HOST har doim smtp.gmail.com bo'ladi, EMAIL_HOST_PASSWORD ga esa 16 belgili Google App Password yoziladi
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=your-email@gmail.com
